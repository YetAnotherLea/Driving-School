# Copier en .env à la racine du dépôt pour le développement local.
# En production, ces variables sont fournies par systemd (EnvironmentFile),
# aucun .env n'est déployé.

# 1 = mode développement (pages d'erreur détaillées, HTTPS non forcé). Jamais en production.
DJANGO_DEBUG=1

# Obligatoire hors debug. À générer une fois, puis à ne jamais changer ni partager :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Hôtes acceptés, séparés par des virgules. Les origines CSRF en sont déduites.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Chemin de la base SQLite. En production : hors de l'arbre déployé.
# DJANGO_DB_PATH=/var/lib/driving-school/db.sqlite3
